{
	"name": "@tumble-code/build",
	"description": "ESBuild utilities for Tumble Code.",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"scripts": {
		"lint": "eslint src --ext=ts --max-warnings=0",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"build": "tsc",
		"clean": "rimraf dist .turbo"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@tumble-code/config-eslint": "workspace:^",
		"@tumble-code/config-typescript": "workspace:^",
		"@tumble-code/config-vitest": "workspace:^",
		"@types/node": "catalog:",
		"vitest": "catalog:"
	}
}
