{
	"name": "@tumble-code/core",
	"private": true,
	"description": "Platform agnostic core functionality for Tumble Code.",
	"version": "0.0.2",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./backoff": "./src/backoff.ts",
		"./cli": "./src/cli.ts",
		"./browser": "./src/browser.ts",
		"./fs": "./src/fs/index.ts",
		"./path": "./src/path/index.ts",
		"./redact": "./src/redact.ts"
	},
	"scripts": {
		"lint": "eslint src --ext=ts --max-warnings=0",
