{
	"name": "@tumble-code/agent-interchange",
	"private": true,
	"description": "Read, brief and hand off coding-agent sessions between Claude Code and Tumble Code.",
	"version": "0.0.2",
	"type": "module",
	"exports": "./src/index.ts",
	"bin": {
		"agent-interchange-mcp": "./dist/mcp-server.mjs",
		"agent-interchange-install": "./dist/install.mjs"
	},
	"scripts": {
		"build": "node esbuild.mjs",
		"install:mcp": "pnpm build && node dist/install.mjs install",
		"uninstall:mcp": "node dist/install.mjs uninstall",
		"lint": "eslint src --ext=ts --max-warnings=0",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rimraf dist .turbo"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "catalog:",
		"@tumble-code/core": "workspace:^",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@tumble-code/config-eslint": "workspace:^",
		"@tumble-code/config-typescript": "workspace:^",
		"@tumble-code/config-vitest": "workspace:^",
		"@types/node": "catalog:",
		"esbuild": "catalog:",
		"rimraf": "catalog:",
		"vitest": "catalog:"
	}
}
