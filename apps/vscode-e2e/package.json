{
	"name": "@tumble-code/vscode-e2e",
	"private": true,
	"scripts": {
		"lint": "eslint src --ext=ts --max-warnings=0",
		"check-types": "tsc -p tsconfig.esm.json --noEmit",
		"format": "prettier --write src",
		"test:ci": "pnpm -w bundle && pnpm --filter @tumble-code/vscode-webview build && pnpm test:run",
		"test:run": "rimraf out && tsc -p tsconfig.json && node --env-file-if-exists=.env.local ./out/runTest.js",
		"test:providers": "TEST_PROVIDERS=1 pnpm test:run",
		"clean": "rimraf out .turbo"
	},
	"devDependencies": {
		"@tumble-code/config-eslint": "workspace:^",
		"@tumble-code/config-typescript": "workspace:^",
		"@tumble-code/types": "workspace:^",
		"@types/mocha": "^10.0.10",
		"@types/node": "catalog:",
		"@types/vscode": "catalog:",
		"@vscode/test-electron": "^3.1.0",
		"glob": "^13.0.6",
		"mocha": "^12.0.3",
		"rimraf": "catalog:"
	}
}
