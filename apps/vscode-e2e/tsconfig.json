{
	"compilerOptions": {
		"module": "CommonJS",
		"moduleResolution": "Bundler",
		"esModuleInterop": true,
		"types": ["node", "mocha"],
		"target": "ES2022",
		"lib": ["ES2022", "ESNext.Disposable", "DOM"],
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"useUnknownInCatchVariables": false,
		"outDir": "out",
		"rootDir": "./src"
	},
	"include": ["src"],
	"exclude": [".vscode-test", "**/node_modules/**", "out"]
}
