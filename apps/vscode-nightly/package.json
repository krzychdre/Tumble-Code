{
	"name": "@tumble-code/vscode-nightly",
	"description": "Nightly build for the Tumble Code VSCode extension.",
	"private": true,
	"scripts": {
		"bundle:nightly": "node esbuild.mjs",
		"vsix:nightly": "cd build && mkdirp ../../../bin && vsce package --no-dependencies --out ../../../bin",
		"clean": "rimraf build .turbo"
	},
	"devDependencies": {
		"@tumble-code/build": "workspace:^",
		"@vscode/vsce": "catalog:"
	}
}
