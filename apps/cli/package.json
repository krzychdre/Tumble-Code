{
	"name": "@tumble-code/cli",
	"version": "0.2.0",
	"description": "Tumble Code CLI - Run the Tumble Code agent from the command line",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"tumble": "dist/index.js"
	},
	"scripts": {
		"format": "prettier --write 'src/**/*.ts'",
		"lint": "eslint src --ext .ts --max-warnings=0",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"test:integration": "tsx scripts/integration/run.ts",
		"build": "tsup",
		"build:extension": "pnpm --filter tumble-code bundle",
		"dev": "tsx src/index.ts",
		"dev:local": "ROO_AUTH_BASE_URL=http://localhost:3000 tsx src/index.ts",
		"clean": "rimraf dist .turbo"
	},
	"dependencies": {
		"@roo-code/core": "workspace:^",
		"@roo-code/types": "workspace:^",
		"@roo-code/vscode-shim": "workspace:^",
		"@vscode/ripgrep": "^1.15.9",
		"commander": "^15.0.0",
		"execa": "^9.5.2",
		"fuzzysort": "^3.1.0",
		"ink": "7.1.1",
		"p-wait-for": "^5.0.2",
		"react": "^19.3.0",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@roo-code/config-eslint": "workspace:^",
		"@roo-code/config-typescript": "workspace:^",
		"@roo-code/config-vitest": "workspace:^",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"ink-testing-library": "^4.0.0",
		"rimraf": "^6.0.1",
		"string-width": "^8.2.2",
		"tsup": "^8.4.0",
		"tsx": "^4.19.3",
		"vitest": "^5.0.2"
	}
}
