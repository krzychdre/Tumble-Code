{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	// The webview compiles ../src/shared through the @roo/* alias, so those files are
	// task inputs here. PKG-6 moved the pure modules into @roo-code/core/browser and
	// @roo-code/types (declared dependencies); the rest (modes, package, ...) still
	// come through the alias.
	"tasks": {
		"build": {
			"outputs": ["../src/webview-ui/**"],
			"inputs": [
				"src/**",
				"package.json",
				"tsconfig.json",
				"tsup.config.ts",
				"vite.config.ts",
				"$TURBO_ROOT$/src/shared/**"
			]
		},
		"build:nightly": {
			"outputs": ["../apps/vscode-nightly/build/webview-ui/**"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/src/shared/**"]
		},
		// lint also runs ../scripts/check-react-compiler-bailouts.mjs against react-compiler-bailouts.json.
		"lint": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/check-react-compiler-bailouts.mjs"]
		},
		"check-types": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/src/shared/**"]
		},
		"test": {
			// Was a "pretest" script running a nested "turbo run bundle"; as a
			// task dependency the extension bundle is built once per run, shared
			// with tumble-code#test (see src/turbo.json).
			"dependsOn": ["@roo-code/types#build", "tumble-code#bundle"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/src/shared/**"]
		}
	}
}
