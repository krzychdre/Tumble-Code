{
	"name": "tumble-code",
	"packageManager": "pnpm@10.8.1",
	"engines": {
		"node": "22.23.3"
	},
	"scripts": {
		"preinstall": "node scripts/bootstrap.mjs",
		"prepare": "husky",
		"install": "node scripts/bootstrap.mjs",
		"install:all": "node scripts/bootstrap.mjs",
		"lint": "turbo lint --log-order grouped --output-logs new-only",
		"check-types": "turbo check-types --log-order grouped --output-logs new-only",
		"test": "turbo test --log-order grouped --output-logs new-only",
		"format": "turbo format --log-order grouped --output-logs new-only",
		"build": "turbo build --log-order grouped --output-logs new-only",
		"bundle": "turbo bundle --log-order grouped --output-logs new-only",
		"bundle:nightly": "turbo bundle:nightly --log-order grouped --output-logs new-only",
		"vsix": "turbo vsix --log-order grouped --output-logs new-only",
		"vsix:nightly": "turbo vsix:nightly --log-order grouped --output-logs new-only",
		"clean": "turbo clean --log-order grouped --output-logs new-only && rimraf dist out bin .vite-port .turbo",
		"install:vsix": "pnpm install --frozen-lockfile && pnpm clean && pnpm vsix && node scripts/install-vsix.js",
		"install:vsix:nightly": "pnpm install --frozen-lockfile && pnpm clean && pnpm vsix:nightly && node scripts/install-vsix.js --nightly",
		"code-server:install": "node scripts/code-server.js",
		"changeset:version": "cp CHANGELOG.md src/CHANGELOG.md && changeset version && cp -vf src/CHANGELOG.md .",
		"knip": "knip",
		"npm:publish:types": "pnpm --filter @roo-code/types npm:publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@dotenvx/dotenvx": "^1.34.0",
		"@roo-code/config-typescript": "workspace:^",
		"@types/node": "^22.20.4",
		"@vscode/vsce": "4.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.11.0",
		"husky": "^9.1.7",
		"knip": "^6.38.0",
		"lint-staged": "^17.6.0",
		"mkdirp": "^3.0.1",
		"prettier": "^3.4.2",
		"rimraf": "^6.0.1",
		"tsx": "^4.19.3",
		"turbo": "^2.9.16",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md}": [
			"prettier --write"
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@vscode/ripgrep"
		],
		"overrides": {
			"tar-fs": ">=3.1.1",
			"esbuild": "^0.28.2",
			"undici": "^7.29.0",
			"jsdom>undici": "^8.10.2",
			"brace-expansion": "^2.0.2",
			"form-data": ">=4.0.4",
			"bluebird": ">=3.7.2",
			"glob": "^13.0.6",
			"zod": "4.6.5",
			"@lmstudio/sdk>zod": "3.25.76",
			"picomatch@>=4": "^4.0.7",
			"typescript": "$typescript"
		},
		"packageExtensions": {
			"@microsoft/fast-react-wrapper": {
				"peerDependencies": {
					"@types/react": "*"
				},
				"peerDependenciesMeta": {
					"@types/react": {
						"optional": true
					}
				}
			},
			"@radix-ui/react-icons": {
				"peerDependencies": {
					"@types/react": "*"
				},
				"peerDependenciesMeta": {
					"@types/react": {
						"optional": true
					}
				}
			},
			"@tanstack/react-query": {
				"peerDependencies": {
					"@types/react": "*"
				},
				"peerDependenciesMeta": {
					"@types/react": {
						"optional": true
					}
				}
			},
			"cmdk": {
				"peerDependencies": {
					"@types/react": "*"
				},
				"peerDependenciesMeta": {
					"@types/react": {
						"optional": true
					}
				}
			},
			"lucide-react": {
				"peerDependencies": {
					"@types/react": "*"
				},
				"peerDependenciesMeta": {
					"@types/react": {
						"optional": true
					}
				}
			},
			"react-i18next": {
				"peerDependencies": {
					"@types/react": "*"
				},
				"peerDependenciesMeta": {
					"@types/react": {
						"optional": true
					}
				}
			},
			"react-icons": {
				"peerDependencies": {
					"@types/react": "*"
				},
				"peerDependenciesMeta": {
					"@types/react": {
						"optional": true
					}
				}
			},
			"react-textarea-autosize": {
				"peerDependencies": {
					"@types/react": "*"
				},
				"peerDependenciesMeta": {
					"@types/react": {
						"optional": true
					}
				}
			},
			"react-use": {
				"peerDependencies": {
					"@types/react": "*"
				},
				"peerDependenciesMeta": {
					"@types/react": {
						"optional": true
					}
				}
			},
			"react-virtuoso": {
				"peerDependencies": {
					"@types/react": "*"
				},
				"peerDependenciesMeta": {
					"@types/react": {
						"optional": true
					}
				}
			},
			"styled-components": {
				"peerDependencies": {
					"@types/react": "*"
				},
				"peerDependenciesMeta": {
					"@types/react": {
						"optional": true
					}
				}
			}
		}
	}
}
