# Python bytecode and tool caches
__pycache__
*.pyc
*.pyo
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# The image builds its own virtual environment (uv sync in the Dockerfile);
# the developer's local one is large and host-specific.
.venv

# Every local env file carries secrets (.env, .env.backup, .env.bak-*, ...).
# The container gets its configuration from the compose environment instead.
# Only the documented template may go in.
.env*
!.env.example

.git
.gitignore
*.md
!README.md
tests/
.vscode/
.vol/
